generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Barang {
  id             String        @id(map: "PK__Barang__3213E83FAACEE62E") @default(dbgenerated("newid()"), map: "DF__Barang__id__5CD6CB2B") @db.UniqueIdentifier
  Nama           String        @db.NVarChar(255)
  id_kategori    String        @db.UniqueIdentifier
  stock          Int           @default(0, map: "DF__Barang__stock__5DCAEF64")
  satuan_harga   Decimal       @db.Decimal(15, 2)
  created_at     DateTime?     @default(now(), map: "DF__Barang__created___5EBF139D")
  updated_at     DateTime?     @default(now(), map: "DF__Barang__updated___5FB337D6")
  tanggal_keluar DateTime?     @db.Date
  created_by     String?       @db.UniqueIdentifier
  updated_by     String?       @db.UniqueIdentifier
  Token          String?       @db.NVarChar(255)
  Kategori       Kategori      @relation(fields: [id_kategori], references: [id], onUpdate: NoAction, map: "Barang_FK")
  Pengeluaran    Pengeluaran[]
  Produk         Produk[]
}

model HistoriPenjualan {
  id               String    @id(map: "PK__HistoriP__3213E83F7DCF9609") @default(dbgenerated("newid()"), map: "DF__HistoriPenju__id__4D94879B") @db.UniqueIdentifier
  id_transaksi     String    @db.UniqueIdentifier
  id_produk_detail String    @db.UniqueIdentifier
  created_at       DateTime? @default(now(), map: "DF__HistoriPe__creat__4E88ABD4")
  updated_at       DateTime? @default(now(), map: "DF__HistoriPe__updat__4F7CD00D")
  created_by       String?   @db.UniqueIdentifier
  updated_by       String?   @db.UniqueIdentifier
  Transaksi        Transaksi @relation(fields: [id_transaksi], references: [id], onUpdate: NoAction, map: "HistoriPenjualan_FK")
  Produk           Produk    @relation(fields: [id_produk_detail], references: [id], onUpdate: NoAction, map: "HistoriPenjualan_FK_1")
}

model Kategori {
  id         String    @id(map: "PK__Kategori__3213E83FC390DE18") @default(dbgenerated("newid()"), map: "DF__Kategori__id__6383C8BA") @db.UniqueIdentifier
  name       String    @unique(map: "UQ__Kategori__72E12F1B39DEA4E6") @db.NVarChar(100)
  created_at DateTime? @default(now(), map: "DF__Kategori__create__6477ECF3")
  updated_at DateTime?
  created_by String?   @db.UniqueIdentifier
  updated_by String?   @db.UniqueIdentifier
  Barang     Barang[]
}

model Pendapatan {
  id                         String     @id(map: "PK__Pendapat__3213E83FC9571B6C") @default(dbgenerated("newid()"), map: "DF__Pendapatan__id__48CFD27E") @db.UniqueIdentifier
  id_transaksi               String?    @unique(map: "UQ__Pendapat__205B81D10999137D") @db.UniqueIdentifier
  total_pendapatan_transaksi Decimal    @db.Decimal(15, 2)
  created_at                 DateTime?  @default(now(), map: "DF__Pendapata__creat__49C3F6B7")
  updated_at                 DateTime?  @default(now(), map: "DF__Pendapata__updat__4AB81AF0")
  created_by                 String?    @db.UniqueIdentifier
  updated_by                 String?    @db.UniqueIdentifier
  Transaksi                  Transaksi? @relation(fields: [id_transaksi], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Pendapatan_FK")
}

model Pengeluaran {
  id                    String    @id(map: "PK__Pengelua__3213E83FA6181269") @default(dbgenerated("newid()"), map: "DF__Pengeluaran__id__4222D4EF") @db.UniqueIdentifier
  id_barang             String?   @db.UniqueIdentifier
  deskripsi_pengeluaran String    @db.NVarChar(255)
  jumlah_barang         Int?
  total_harga           Decimal   @db.Decimal(15, 2)
  tanggal_pengeluaran   DateTime  @default(dbgenerated("CONVERT([date],getdate())"), map: "DF__Pengeluar__tangg__4316F928") @db.Date
  created_at            DateTime? @default(now(), map: "DF__Pengeluar__creat__440B1D61")
  updated_at            DateTime? @default(now(), map: "DF__Pengeluar__updat__44FF419A")
  created_by            String?   @db.UniqueIdentifier
  updated_by            String?   @db.UniqueIdentifier
  Barang                Barang?   @relation(fields: [id_barang], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Pengeluaran_FK")
}

model Produk {
  id                   String             @id(map: "PK__Produk__3213E83F6C3DFDF2") @default(dbgenerated("newid()"), map: "DF__Produk__id__52593CB8") @db.UniqueIdentifier
  id_transaksi         String             @db.UniqueIdentifier
  id_barang            String             @db.UniqueIdentifier
  jumlah_barang        Int
  harga_saat_transaksi Decimal            @db.Decimal(15, 2)
  created_at           DateTime?          @default(now(), map: "DF__Produk__created___534D60F1")
  updated_at           DateTime?          @default(now(), map: "DF__Produk__updated___5441852A")
  created_by           String?            @db.UniqueIdentifier
  updated_by           String?            @db.UniqueIdentifier
  HistoriPenjualan     HistoriPenjualan[]
  Barang               Barang             @relation(fields: [id_barang], references: [id], onUpdate: NoAction, map: "Produk_FK")
  Transaksi            Transaksi          @relation(fields: [id_transaksi], references: [id], onUpdate: NoAction, map: "Produk_FK_1")
}

model Role {
  id         String    @id(map: "PK__Role__3213E83F5A7CE42E") @default(dbgenerated("newid()"), map: "DF__Role__id__6EF57B66") @db.UniqueIdentifier
  name       String    @unique(map: "UQ__Role__72E12F1B752E3AAA") @db.NVarChar(100)
  created_at DateTime? @default(now(), map: "DF__Role__created_at__6FE99F9F")
  updated_at DateTime? @default(now(), map: "DF__Role__updated_at__70DDC3D8")
  created_by String?   @db.UniqueIdentifier
  updated_by String?   @db.UniqueIdentifier
  User       User[]
}

model Transaksi {
  id                      String             @id(map: "PK__Transaks__3213E83FB149B6B3") @default(dbgenerated("newid()"), map: "DF__Transaksi__id__571DF1D5") @db.UniqueIdentifier
  deskripsi_service       String?            @db.NVarChar(Max)
  total_harga_keseluruhan Decimal            @db.Decimal(15, 2)
  is_service              Boolean            @default(false, map: "DF__Transaksi__is_se__5812160E")
  created_at              DateTime?          @default(now(), map: "DF__Transaksi__creat__59063A47")
  updated_at              DateTime?          @default(now(), map: "DF__Transaksi__updat__59FA5E80")
  created_by              String?            @db.UniqueIdentifier
  updated_by              String?            @db.UniqueIdentifier
  HistoriPenjualan        HistoriPenjualan[]
  Pendapatan              Pendapatan?
  Produk                  Produk[]
}

model User {
  id         String    @id(map: "PK__User__3213E83F4BBF2674") @default(dbgenerated("newid()"), map: "DF__User__id__693CA210") @db.UniqueIdentifier
  username   String    @unique(map: "UQ__User__F3DBC572DA2082F0") @db.NVarChar(255)
  password   String    @db.NVarChar(255)
  id_role    String    @db.UniqueIdentifier
  created_at DateTime? @default(now(), map: "DF__User__created_at__6A30C649")
  updated_at DateTime? @default(now(), map: "DF__User__updated_at__6B24EA82")
  created_by String?   @db.UniqueIdentifier
  updated_by String?   @db.UniqueIdentifier
  Role       Role      @relation(fields: [id_role], references: [id], onUpdate: NoAction, map: "User_FK")
}
